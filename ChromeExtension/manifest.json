{
    "manifest_version": 3,
    "name": "MediaRPC Extension",
    "version": "1.0",
    "description": "Reads Media Session API metadata and sends to MediaRPC Wpf app.",
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}